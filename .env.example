APP_ENV=development
LOG_LEVEL=INFO
AUTH_MODE=local
STORAGE_BACKEND=memory
AWS_REGION=us-east-1
CASE_ACCESS_SECRET=development-only-change-me

# DynamoDB mode
CASES_TABLE=reliefos-cases
PEOPLE_TABLE=reliefos-people
RESPONDERS_TABLE=reliefos-responders
SHELTERS_TABLE=reliefos-shelters
MISSIONS_TABLE=reliefos-missions
AUDIT_TABLE=reliefos-audit
DYNAMODB_ENDPOINT_URL=

# Media and queue integrations
MEDIA_BUCKET=
CASE_QUEUE_URL=
MAX_MEDIA_BYTES=25000000

# AI triage is optional. Deterministic triage always runs first.
AI_TRIAGE_ENABLED=false
BEDROCK_MODEL_ID=
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=

# Cognito mode
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
